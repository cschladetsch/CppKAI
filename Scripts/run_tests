#!/bin/bash

# Exit on error
set -e

rm -rf build

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

run_test() {
    local name="$1"
    shift

    for path in "$@"; do
        if [ -x "$path" ]; then
            "$path"
            return 0
        fi
    done

    echo "Error: ${name} binary not found" >&2
    return 1
}

# Run all test executables from the in-tree output paths used by this
# repository.
run_test TestCore \
    "$ROOT_DIR/Bin/Test/TestCore"
run_test TestPi \
    "$ROOT_DIR/Bin/Test/TestPi"
run_test TestRho \
    "$ROOT_DIR/Bin/Test/TestRho"
run_test TestTau \
    "$ROOT_DIR/Bin/Test/TestTau"
run_test TestNetwork \
    "$ROOT_DIR/Bin/Test/TestNetwork"

echo "All tests passed!"
