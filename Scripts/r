python3 - << 'EOF'
path = "Test/demo_console_communication.sh"
with open(path, 'r') as f:
    content = f.read()

# Fix tmux escape char
content = content.replace("Ctrl+b", "Ctrl+a")

# Fix garbled unicode bullets and checkmarks
content = content.replace("ΓÇó", "-")
content = content.replace("Γ£ô", "✓")
content = content.replace("Γåö", "<->")

with open(path, 'w') as f:
    f.write(content)
print("Done")
EOF
