// Word frequencies with parallel lists, and the distinct words sorted.

words = ["the", "cat", "sat", "on", "the", "mat", "the", "cat"]

distinct: List[str] = []
counts: List[int] = []
for w in words
    found = -1
    for i = 0; i < distinct.size(); i += 1
        if distinct[i] == w
            found = i
    if found == -1
        distinct.push(w)
        counts.push(1)
    else
        counts[found] = counts[found] + 1

top = 0
for i = 1; i < distinct.size(); i += 1
    if counts[i] > counts[top]
        top = i

for i = 1; i < distinct.size(); i += 1
    j = i
    moving = true
    while moving && j > 0
        if distinct[j - 1] > distinct[j]
            t = distinct[j]
            distinct[j] = distinct[j - 1]
            distinct[j - 1] = t
            j -= 1
        else
            moving = false

distinct.size() == 5 && distinct[top] != "" && counts[0] == 3 && counts[1] == 2 && distinct[0] == "cat" && distinct[4] == "the" && distinct[2] == "on"
