// Boyer-Moore majority vote: one pass finds the only possible majority, a
// second pass counts it to confirm.

fun candidate(xs: List[int]) -> int
    count = 0
    cand = 0
    for x in xs
        if count == 0
            cand = x
            count = 1
        else if x == cand
            count += 1
        else
            count -= 1
    return cand

fun occurrences(xs: List[int], v: int) -> int
    n = 0
    for x in xs
        if x == v
            n += 1
    return n

fun majority(xs: List[int]) -> int
    c = candidate(xs)
    return occurrences(xs, c) * 2 > xs.size() ? c : -1

majority([2, 2, 1, 1, 1, 2, 2]) == 2 && majority([3, 1, 3, 2, 3, 3, 4, 3]) == 3 && majority([1, 2, 3, 4, 5]) == -1 && candidate([1, 2, 3, 4, 5]) == 5 && majority([7]) == 7
