// Dijkstra's shortest paths over a weighted adjacency matrix (0 = no edge).

big = 1000000
w = [[0, 4, 1, 0, 0], [4, 0, 2, 5, 0], [1, 2, 0, 8, 10], [0, 5, 8, 0, 3], [0, 0, 10, 3, 0]]

fun dijkstra(src: int) -> List[int]
    n = w.size()
    dist: List[int] = []
    done: List[bool] = []
    for i = 0; i < n; i += 1
        dist.push(big)
        done.push(false)
    dist[src] = 0
    for step = 0; step < n; step += 1
        u = -1
        for i = 0; i < n; i += 1
            if !done[i]
                if u == -1
                    u = i
                else if dist[i] < dist[u]
                    u = i
        done[u] = true
        for v = 0; v < n; v += 1
            if w[u][v] > 0 && dist[u] + w[u][v] < dist[v]
                dist[v] = dist[u] + w[u][v]
    return dist

d = dijkstra(0)
e = dijkstra(4)
d[0] == 0 && d[1] == 3 && d[2] == 1 && d[3] == 8 && d[4] == 11 && e[0] == 11 && e[1] == 8
