// Best profit from one buy and sell, and from any number of non-overlapping
// trades, over a list of daily prices.

fun bestSingleTrade(prices: List[int]) -> int
    lowest = prices[0]
    best = 0
    for p in prices
        if p < lowest
            lowest = p
        else if p - lowest > best
            best = p - lowest
    return best

fun bestManyTrades(prices: List[int]) -> int
    total = 0
    for i = 1; i < prices.size(); i += 1
        if prices[i] > prices[i - 1]
            total += prices[i] - prices[i - 1]
    return total

rising = [7, 1, 5, 3, 6, 4]
falling = [9, 8, 6, 5, 4]
choppy = [3, 3, 5, 0, 0, 3, 1, 4]
bestSingleTrade(rising) == 5 && bestManyTrades(rising) == 7 && bestSingleTrade(falling) == 0 && bestManyTrades(falling) == 0 && bestSingleTrade(choppy) == 4 && bestManyTrades(choppy) == 8
