// Selection sort over floats, with int literals widened in the list.

fun selectionSort(xs: List[float]) -> List[float]
    n = xs.size()
    for i = 0; i < n - 1; i += 1
        m = i
        for j = i + 1; j < n; j += 1
            if xs[j] < xs[m]
                m = j
        if m != i
            t = xs[i]
            xs[i] = xs[m]
            xs[m] = t
    return xs

data: List[float] = [3.5, -1, 2.25, 0, 10, -7.5]
s = selectionSort(data)
s[0] == -7.5 && s[1] == -1.0 && s[2] == 0.0 && s[3] == 2.25 && s[5] == 10.0
