// Integer square roots by Newton's method find 40755, the first number after
// 1 that is triangular, pentagonal and hexagonal.

fun isqrt(n: int) -> int
    if n < 2
        return n
    x = n
    y = (x + 1) / 2
    while y < x
        x = y
        y = (x + n / x) / 2
    return x

fun isPentagonal(x: int) -> bool
    d = 1 + 24 * x
    r = isqrt(d)
    return r * r == d && (1 + r) % 6 == 0

fun isTriangular(x: int) -> bool
    d = 1 + 8 * x
    r = isqrt(d)
    return r * r == d && (r - 1) % 2 == 0

found = 0
h = 144
for k = 2; k < 200; k += 1
    hex = k * (2 * k - 1)
    if found == 0 && isPentagonal(hex) && isTriangular(hex)
        found = hex
        h = k

isqrt(0) == 0 && isqrt(15) == 3 && isqrt(16) == 4 && isqrt(1000000) == 1000 && found == 40755 && h == 143
