// '!' (replace) is a tail call: the callee takes the place of the running
// function, which never resumes. Here it sums 1..n with an accumulator.

fun sumTo(n: int, acc: int) -> int
    if n == 0
        return acc
    return sumTo(n - 1, acc + n)!

sumTo(0, 0) == 0 && sumTo(10, 0) == 55 && sumTo(100, 0) == 5050 && sumTo(20000, 0) == 200010000
