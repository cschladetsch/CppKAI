// A reverse Polish evaluator over a list of ints with a list as the stack.
// Operators are encoded as negative numbers: -1 add, -2 subtract,
// -3 multiply, -4 divide.

fun evalRpn(tokens: List[int]) -> int
    stack: List[int] = []
    for t in tokens
        if t >= 0
            stack.push(t)
        else
            n = stack.size()
            b = stack[n - 1]
            a = stack[n - 2]
            stack = stack.slice(0, n - 2)
            r = 0
            if t == -1
                r = a + b
            else if t == -2
                r = a - b
            else if t == -3
                r = a * b
            else
                r = a / b
            stack.push(r)
    return stack[0]

// (3 + 4) * (10 - 2) / 4 and 5 + (1 + 2) * 4 - 3
evalRpn([3, 4, -1, 10, 2, -2, -3, 4, -4]) == 14 && evalRpn([5, 1, 2, -1, 4, -3, -1, 3, -2]) == 14 && evalRpn([42]) == 42
