// Euclid's algorithm as a tail call, with lcm built on it.

fun gcd(a: int, b: int) -> int
    if b == 0
        return a
    return gcd(b, a % b)!

fun lcm(a: int, b: int) -> int
    return a / gcd(a, b) * b

gcd(48, 18) == 6 && gcd(17, 5) == 1 && gcd(0, 9) == 9 && lcm(4, 6) == 12 && lcm(21, 6) == 42
