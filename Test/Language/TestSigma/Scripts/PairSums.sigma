// Two-pointer searches over a sorted list: pairs with a given sum, and the
// distinct triples that sum to zero.

fun countPairs(xs: List[int], target: int) -> int
    count = 0
    for i = 0; i < xs.size(); i += 1
        for j = i + 1; j < xs.size(); j += 1
            if xs[i] + xs[j] == target
                count += 1
    return count

fun zeroTriples(xs: List[int]) -> List[List[int]]
    out: List[List[int]] = []
    n = xs.size()
    for i = 0; i < n - 2; i += 1
        fresh = i == 0
        if !fresh
            fresh = xs[i] != xs[i - 1]
        if fresh
            lo = i + 1
            hi = n - 1
            while lo < hi
                s = xs[i] + xs[lo] + xs[hi]
                if s < 0
                    lo += 1
                else if s > 0
                    hi -= 1
                else
                    out.push([xs[i], xs[lo], xs[hi]])
                    lo += 1
                    while lo < hi && xs[lo] == xs[lo - 1]
                        lo += 1
                    hi -= 1
    return out

sortedNums = [-4, -1, -1, 0, 1, 2, 3, 5]
triples = zeroTriples(sortedNums)
first = triples[0]
lastTriple = triples[3]
countPairs(sortedNums, 4) == 3 && countPairs(sortedNums, 100) == 0 && triples.size() == 4 && first[0] == -4 && first[1] == -1 && first[2] == 5 && lastTriple[0] == -1 && lastTriple[1] == 0 && lastTriple[2] == 1
