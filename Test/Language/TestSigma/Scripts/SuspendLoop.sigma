// Suspending into a function on every iteration of a loop: each call
// returns to the loop body before the next one starts.

fun square(n: int) -> int
    return n * n

total = 0
for i = 1; i <= 10; i += 1
    total += square(i)&

odd = 0
for x in [1, 3, 5, 7]
    odd += square(x)&

total == 385 && odd == 84
