// Disjoint sets with path compression, counting connected components.

parent: List[int] = []

fun find(x: int) -> int
    root = x
    while parent[root] != root
        root = parent[root]
    while parent[x] != root
        up = parent[x]
        parent[x] = root
        x = up
    return root

fun join(a: int, b: int)
    ra = find(a)
    rb = find(b)
    if ra != rb
        parent[ra] = rb

for i = 0; i < 10; i += 1
    parent.push(i)

pairs = [[0, 1], [1, 2], [3, 4], [5, 6], [6, 7], [7, 5], [8, 9], [2, 0]]
for p in pairs
    join(p[0], p[1])

components = 0
for i = 0; i < 10; i += 1
    if find(i) == i
        components += 1

components == 4 && find(0) == find(2) && find(5) == find(7) && find(3) != find(5)
