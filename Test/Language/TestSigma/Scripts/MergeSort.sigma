// Recursive merge sort using slice.

fun merge(a: List[int], b: List[int]) -> List[int]
    out: List[int] = []
    i = 0
    j = 0
    while i < a.size() || j < b.size()
        if j >= b.size()
            out.push(a[i])
            i += 1
        else if i >= a.size()
            out.push(b[j])
            j += 1
        else if a[i] <= b[j]
            out.push(a[i])
            i += 1
        else
            out.push(b[j])
            j += 1
    return out

fun mergeSort(xs: List[int]) -> List[int]
    n = xs.size()
    if n <= 1
        return xs
    mid = n / 2
    return merge(mergeSort(xs.slice(0, mid)), mergeSort(xs.slice(mid, n)))

s = mergeSort([38, 27, 43, 3, 9, 82, 10, 3])
s.size() == 8 && s[0] == 3 && s[1] == 3 && s[2] == 9 && s[5] == 38 && s[7] == 82
