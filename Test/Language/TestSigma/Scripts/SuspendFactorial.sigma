// Ordinary (non-tail) recursion: the multiply happens after the suspended
// call returns, so every level stays on the context stack until then.

fun fact(n: int) -> int
    if n <= 1
        return 1
    return n * fact(n - 1)&

fact(0) == 1 && fact(5) == 120 && fact(10) == 3628800 && fact(12) == 479001600
