// Binary search with a single exit.

fun find(xs: List[int], target: int) -> int
    lo = 0
    hi = xs.size() - 1
    found = -1
    while lo <= hi && found == -1
        mid = (lo + hi) / 2
        if xs[mid] == target
            found = mid
        else if xs[mid] < target
            lo = mid + 1
        else
            hi = mid - 1
    return found

xs = [1, 3, 5, 7, 9, 11, 13]
find(xs, 1) == 0 && find(xs, 7) == 3 && find(xs, 13) == 6 && find(xs, 4) == -1
