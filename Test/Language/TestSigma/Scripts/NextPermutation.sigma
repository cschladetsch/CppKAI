// Lexicographic next permutation in place; stepping from the sorted order
// visits every distinct permutation once.

fun nextPermutation(xs: List[int]) -> bool
    i = xs.size() - 2
    searching = true
    while searching
        if i < 0
            searching = false
        else if xs[i] < xs[i + 1]
            searching = false
        else
            i -= 1
    if i < 0
        return false
    j = xs.size() - 1
    while xs[j] <= xs[i]
        j -= 1
    t = xs[i]
    xs[i] = xs[j]
    xs[j] = t
    lo = i + 1
    hi = xs.size() - 1
    while lo < hi
        t = xs[lo]
        xs[lo] = xs[hi]
        xs[hi] = t
        lo += 1
        hi -= 1
    return true

fun countPermutations(xs: List[int]) -> int
    count = 1
    while nextPermutation(xs)
        count += 1
    return count

p = [1, 2, 3]
nextPermutation(p)
p[0] == 1 && p[1] == 3 && p[2] == 2 && countPermutations([1, 2, 3, 4]) == 24 && countPermutations([1, 1, 2, 2]) == 6 && !nextPermutation([3, 2, 1])
