// Identity, product and transpose of square matrices; (AB)^T == B^T A^T.

fun identity(n: int) -> List[List[int]]
    m: List[List[int]] = []
    for i = 0; i < n; i += 1
        row: List[int] = []
        for j = 0; j < n; j += 1
            row.push(i == j ? 1 : 0)
        m.push(row)
    return m

fun multiply(a: List[List[int]], b: List[List[int]]) -> List[List[int]]
    n = a.size()
    out: List[List[int]] = []
    for i = 0; i < n; i += 1
        row: List[int] = []
        for j = 0; j < n; j += 1
            s = 0
            for k = 0; k < n; k += 1
                s += a[i][k] * b[k][j]
            row.push(s)
        out.push(row)
    return out

fun transpose(a: List[List[int]]) -> List[List[int]]
    out: List[List[int]] = []
    for j = 0; j < a.size(); j += 1
        row: List[int] = []
        for i = 0; i < a.size(); i += 1
            row.push(a[i][j])
        out.push(row)
    return out

fun equal(a: List[List[int]], b: List[List[int]]) -> bool
    ok = true
    for i = 0; i < a.size(); i += 1
        for j = 0; j < a.size(); j += 1
            ok = ok && a[i][j] == b[i][j]
    return ok

a = [[2, -1, 0], [1, 3, 4], [0, 5, -2]]
b = [[1, 2, 3], [0, 1, 0], [4, 0, 1]]
aa = multiply(a, a)
equal(multiply(a, identity(3)), a) && equal(transpose(transpose(a)), a) && equal(transpose(multiply(a, b)), multiply(transpose(b), transpose(a))) && aa[1][2] == 4
