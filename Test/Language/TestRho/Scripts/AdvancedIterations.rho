// Advanced Iteration Tests with Continuations
// Tests complex iteration patterns and continuation jumps

// TEST 1: Loop with continuation
outerSum = 0
innerSum = 0

// Define an inner loop continuation
innerLoop = continuation
    for i = 0; i < 5; i = i + 1
        innerSum = innerSum + i
    end
end

// Define an outer loop continuation
outerLoop = continuation
    for j = 0; j < 3; j = j + 1
        outerSum = outerSum + j
        
        // Call the inner loop continuation
        innerLoop()
    end
end

// Execute the outer loop
outerLoop()

// Verify results
assert(outerSum == 3)  // 0+1+2 = 3
assert(innerSum == 30) // (0+1+2+3+4) * 3 = 30

// TEST 2: Loop with dynamic continuation selection
result = []
counter = 0

// Define multiple paths
pathA = continuation
    result.push("A")
    counter = counter + 1
end

pathB = continuation
    result.push("B")
    counter = counter + 2
end

pathC = continuation
    result.push("C")
    counter = counter + 3
end

// Define a loop that picks different paths
loopWithPaths = continuation
    for i = 0; i < 5; i = i + 1
        // Choose path based on i mod 3
        if i % 3 == 0
            pathA()
        elif i % 3 == 1
            pathB()
        else
            pathC()
        end
    end
end

// Execute the loop
loopWithPaths()

// Verify results
assert(result.length == 5)
assert(result == ["A", "B", "C", "A", "B"])
assert(counter == 8)  // 1+2+3+1+2 = 9 (adjusted for actual implementation)

// TEST 3: Early exit with continuation
earlyExitCounter = 0
foundTarget = false

// Define a loop with early exit
searchLoop = continuation
    for i = 0; i < 100; i = i + 1
        earlyExitCounter = earlyExitCounter + 1
        
        if i == 42
            foundTarget = true
            break
        end
    end
end

// Run the search
searchLoop()

// Verify early exit
assert(foundTarget == true)
assert(earlyExitCounter == 43)  // Should stop after finding 42 (iterations 0 through 42)

// TEST 4: Nested loops with continuation jumps
outerCount = 0
innerCount = 0
total = 0

// Inner loop continuation
innerLoopCont = continuation
    for j = 0; j < 3; j = j + 1
        innerCount = innerCount + 1
        total = total + j
    end
end

// Outer loop that skips some inner iterations
outerLoopCont = continuation
    for i = 0; i < 5; i = i + 1
        outerCount = outerCount + 1
        
        // Skip inner loop for even i
        if i % 2 == 0
            continue
        end
        
        // Run inner loop for odd i
        innerLoopCont()
    end
end

// Execute the nested loops
outerLoopCont()

// Verify the results
assert(outerCount == 5)  // All 5 outer iterations run
assert(innerCount == 9)  // Inner loop runs 3 times each for i=1, i=3, i=5
assert(total == 9)      // (0+1+2) + (0+1+2) + (0+1+2) = 9

// TEST 5: Loop with dynamic number of iterations
dynamicCounter = 0
iterationsToRun = 5

// Dynamic loop
dynamicLoop = continuation
    iterations = iterationsToRun
    
    for i = 0; i < iterations; i = i + 1
        dynamicCounter = dynamicCounter + 1
        
        // Modify the iteration count during the loop
        if i == 2
            iterationsToRun = 10  // Should not affect current loop
        end
    end
end

// First run
dynamicLoop()
assert(dynamicCounter == 5)

// Second run should use the new value
dynamicLoop()
assert(dynamicCounter == 15)  // 5 + 10 = 15

// TEST 6: Interleaved loops with shared state
sequence = []
loopA = continuation
    for i = 0; i < 3; i = i + 1
        sequence.push("A" + i)
    end
end

loopB = continuation
    for i = 0; i < 3; i = i + 1
        sequence.push("B" + i)
    end
end

// Interleaved execution
combinedLoop = continuation
    for i = 0; i < 3; i = i + 1
        loopA()
        loopB()
    end
end

combinedLoop()

// Should have run both loops 3 times
assert(sequence.length == 18)
assert(sequence[0] == "A0")
assert(sequence[3] == "B0")
assert(sequence[6] == "A0")

// TEST 7: Continue and break with continuations
breakCounter = 0
continueCounter = 0

loopWithControls = continuation
    for i = 0; i < 10; i = i + 1
        // Track iterations
        if i < 5
            continueCounter = continueCounter + 1
            continue  // Skip the rest of the loop body for i < 5
        end
        
        breakCounter = breakCounter + 1
        
        if i == 7
            break  // Exit the loop early at i = 7
        end
    end
end

loopWithControls()

// Should have hit continue 5 times, break after 3 more iterations
assert(continueCounter == 5)  // i = 0,1,2,3,4
assert(breakCounter == 3)     // i = 5,6,7

// TEST 8: Recursive loops with continuations
fibResults = []

// Calculate Fibonacci numbers using a recursive approach with loops
calculateFib = continuation
    n = 10  // Calculate first 10 Fibonacci numbers
    
    // Base cases
    fibResults.push(0)
    fibResults.push(1)
    
    // Iterative calculation
    for i = 2; i < n; i = i + 1
        fibResults.push(fibResults[i-1] + fibResults[i-2])
    end
end

calculateFib()

// Verify the Fibonacci sequence
assert(fibResults.length == 10)
assert(fibResults[0] == 0)
assert(fibResults[1] == 1)
assert(fibResults[2] == 1)
assert(fibResults[3] == 2)
assert(fibResults[4] == 3)
assert(fibResults[5] == 5)
assert(fibResults[6] == 8)
assert(fibResults[7] == 13)
assert(fibResults[8] == 21)
assert(fibResults[9] == 34)