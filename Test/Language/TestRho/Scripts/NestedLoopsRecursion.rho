// Nested loops, recursion, mutual recursion, tail recursion, continuations in Rho

// nested for loops - sum of products
sum = 0
for (i = 1; i <= 3; i = i + 1) {
    for (j = 1; j <= 3; j = j + 1) {
        sum = sum + i * j
    }
}
assert sum == 36

// nested while loops
outer = 0
i = 1
while (i <= 4) {
    j = 1
    while (j <= 4) {
        outer = outer + 1
        j = j + 1
    }
    i = i + 1
}
assert outer == 16

// for inside while
total = 0
n = 3
while (n > 0) {
    for (k = 1; k <= n; k = k + 1) {
        total = total + k
    }
    n = n - 1
}
assert total == 10

// while inside for
count = 0
for (i = 0; i < 4; i = i + 1) {
    x = i
    while (x > 0) {
        count = count + 1
        x = x - 1
    }
}
assert count == 6

// break out of inner loop only
result = 0
for (i = 1; i <= 3; i = i + 1) {
    for (j = 1; j <= 5; j = j + 1) {
        if (j > 2) {
            break
        }
        result = result + 1
    }
}
assert result == 6

// continue in inner loop
result = 0
for (i = 1; i <= 3; i = i + 1) {
    for (j = 1; j <= 4; j = j + 1) {
        if (j == 2) {
            continue
        }
        result = result + 1
    }
}
assert result == 9

// triple nested for
total = 0
for (a = 1; a <= 2; a = a + 1) {
    for (b = 1; b <= 2; b = b + 1) {
        for (c = 1; c <= 2; c = c + 1) {
            total = total + 1
        }
    }
}
assert total == 8

// simple recursion - factorial
factorial = fun(n)
    if (n <= 1) {
        return 1
    }
    return n * factorial(n - 1)

assert factorial(0) == 1
assert factorial(1) == 1
assert factorial(5) == 120
assert factorial(7) == 5040

// simple recursion - fibonacci
fib = fun(n)
    if (n <= 0) { return 0 }
    if (n == 1) { return 1 }
    return fib(n - 1) + fib(n - 2)

assert fib(0) == 0
assert fib(1) == 1
assert fib(6) == 8
assert fib(10) == 55

// tail recursive factorial with accumulator
fact_tail = fun(n, acc)
    if (n <= 1) { return acc }
    return fact_tail(n - 1, n * acc)

assert fact_tail(5, 1) == 120
assert fact_tail(10, 1) == 3628800

// tail recursive sum
sum_tail = fun(n, acc)
    if (n <= 0) { return acc }
    return sum_tail(n - 1, acc + n)

assert sum_tail(10, 0) == 55
assert sum_tail(100, 0) == 5050

// tail recursive fibonacci with two accumulators
fib_tail = fun(n, a, b)
    if (n == 0) { return a }
    return fib_tail(n - 1, b, a + b)

assert fib_tail(0, 0, 1) == 0
assert fib_tail(6, 0, 1) == 8
assert fib_tail(10, 0, 1) == 55

// mutual recursion - even/odd
is_even = fun(n)
    if (n == 0) { return true }
    return is_odd(n - 1)

is_odd = fun(n)
    if (n == 0) { return false }
    return is_even(n - 1)

assert is_even(0) == true
assert is_even(4) == true
assert is_even(7) == false
assert is_odd(1) == true
assert is_odd(6) == false

// mutual recursion - counting down
count_a = fun(n)
    if (n <= 0) { return 0 }
    return count_b(n - 1) + 1

count_b = fun(n)
    if (n <= 0) { return 0 }
    return count_a(n - 1) + 1

assert count_a(4) == 4
assert count_b(6) == 6

// recursion building a sum with nested call
sum_of_factorials = fun(n)
    if (n <= 0) { return 0 }
    return factorial(n) + sum_of_factorials(n - 1)

assert sum_of_factorials(4) == 33

// recursion inside a for loop
results = []
for (i = 1; i <= 5; i = i + 1) {
    results.append(factorial(i))
}
assert results[0] == 1
assert results[1] == 2
assert results[2] == 6
assert results[3] == 24
assert results[4] == 120

// recursion inside a while loop
total = 0
i = 1
while (i <= 5) {
    total = total + fib(i)
    i = i + 1
}
assert total == 12

// nested recursion - ackermann for small values
ack = fun(m, n)
    if (m == 0) { return n + 1 }
    if (n == 0) { return ack(m - 1, 1) }
    return ack(m - 1, ack(m, n - 1))

assert ack(0, 0) == 1
assert ack(1, 1) == 3
assert ack(2, 2) == 7
assert ack(3, 2) == 29

// pi block used in tail position via recursion
apply_n = fun(f, x, n)
    if (n <= 0) { return x }
    return apply_n(f, f x @, n - 1)

double_block = pi { 2 * }
assert apply_n(double_block, 1, 4) == 16

inc_block = pi { 1 + }
assert apply_n(inc_block, 0, 5) == 5

// recursive accumulation into a list
collect = fun(n, acc)
    if (n <= 0) { return acc }
    acc.append(n)
    return collect(n - 1, acc)

gathered = collect(5, [])
assert gathered.Count == 5
assert gathered[0] == 5
assert gathered[4] == 1

// nested for with recursive call
grid_sum = 0
for (row = 1; row <= 3; row = row + 1) {
    for (col = 1; col <= 3; col = col + 1) {
        grid_sum = grid_sum + fib(row + col - 1)
    }
}
assert grid_sum == 60

System.Print("NestedLoopsRecursion: all tests passed")
