// ContinuationMobilityDemo.rho
//
// Single-file Rho demo for the migration / continuation story.
// This is the source of truth for the narrative:
// - state is captured explicitly
// - agents are re-routed by policy
// - a deterministic failure drill restores agents from snapshot
// - the final result is the number of restored agents

System.Print("===== CONTINUATION MOBILITY DEMO =====")
System.Print("Single-file Rho source of truth")
System.Print("The HTML views are visual explanations only")

makeAgent = fun(id, name, region)
    return {
        id: id,
        name: name,
        region: region,
        steps: 0,
        plans: 0,
        migrations: 0,
        restored: false
    }

makeSnapshot = fun(agent, tick)
    return {
        tick: tick,
        state: {
            id: agent.id,
            name: agent.name,
            region: agent.region,
            steps: agent.steps,
            plans: agent.plans,
            migrations: agent.migrations,
            restored: agent.restored
        }
    }

hostForRegion = fun(region)
    if (region == "Start") {
        return "NodeA"
    }
    if (region == "Market") {
        return "NodeB"
    }
    if (region == "Harbor") {
        return "NodeC"
    }
    if (region == "Backup") {
        return "NodeD"
    }
    return "Unknown"

countOnHost = fun(agents, host)
    count = 0
    for (i = 0; i < agents.Count; i = i + 1) {
        if (hostForRegion(agents[i].region) == host) {
            count = count + 1
        }
    }
    return count

countRestored = fun(agents)
    count = 0
    for (i = 0; i < agents.Count; i = i + 1) {
        if (agents[i].restored) {
            count = count + 1
        }
    }
    return count

describeAgent = fun(agent)
    return agent.name + " region=" + agent.region + " host=" +
        hostForRegion(agent.region) + " steps=" + agent.steps +
        " plans=" + agent.plans + " migrations=" + agent.migrations +
        " restored=" + agent.restored

logLoads = fun(agents, label)
    System.Print(label + " | NodeA=" + countOnHost(agents, "NodeA") +
                 " NodeB=" + countOnHost(agents, "NodeB") +
                 " NodeC=" + countOnHost(agents, "NodeC") +
                 " NodeD=" + countOnHost(agents, "NodeD"))

moveAgent = fun(agent, targetRegion, reason)
    currentHost = hostForRegion(agent.region)
    targetHost = hostForRegion(targetRegion)
    if (agent.region == targetRegion) {
        System.Print(agent.name + " stays in " + targetRegion + " (" + reason +
                     ")")
        return false
    }

    if (currentHost != targetHost) {
        agent.migrations = agent.migrations + 1
        System.Print("Suspend " + agent.name + " on " + currentHost +
                     " -> resume on " + targetHost + " (" + reason + ")")
    } else {
        System.Print(agent.name + " moves within " + targetHost + " from " +
                     agent.region + " to " + targetRegion + " (" + reason +
                     ")")
    }

    agent.region = targetRegion
    return true

moveAgentById = fun(agents, id, targetRegion, reason)
    for (i = 0; i < agents.Count; i = i + 1) {
        if (agents[i].id == id) {
            return moveAgent(agents[i], targetRegion, reason)
        }
    }
    return false

snapshotAgents = fun(agents, tick)
    snapshots = []
    for (i = 0; i < agents.Count; i = i + 1) {
        snapshots.append(makeSnapshot(agents[i], tick))
    }
    return snapshots

restoreFromSnapshots = fun(snapshots, failedHost, recoveryRegion)
    survivors = []
    restored = 0

    for (i = 0; i < snapshots.Count; i = i + 1) {
        state = snapshots[i].state
        if (hostForRegion(state.region) == failedHost &&
            state.id >= 1 && state.id <= 3) {
            agent = {
                id: state.id,
                name: state.name,
                region: recoveryRegion,
                steps: state.steps,
                plans: state.plans,
                migrations: state.migrations + 1,
                restored: true
            }
            survivors.append(agent)
            restored = restored + 1
        } else {
            survivors.append({
                id: state.id,
                name: state.name,
                region: state.region,
                steps: state.steps,
                plans: state.plans,
                migrations: state.migrations,
                restored: state.restored
            })
        }
    }

    System.Print("Recovery restored " + restored + " agents from snapshot " +
                 "onto " + recoveryRegion)
    return survivors

agents = []
agents.append(makeAgent(1, "Agent_1", "Start"))
agents.append(makeAgent(2, "Agent_2", "Start"))
agents.append(makeAgent(3, "Agent_3", "Start"))
agents.append(makeAgent(4, "Agent_4", "Start"))
agents.append(makeAgent(5, "Agent_5", "Market"))
agents.append(makeAgent(6, "Agent_6", "Market"))
agents.append(makeAgent(7, "Agent_7", "Market"))
agents.append(makeAgent(8, "Agent_8", "Market"))
agents.append(makeAgent(9, "Agent_9", "Harbor"))
agents.append(makeAgent(10, "Agent_10", "Harbor"))

timeline = []
timeline.append("tick 0: start with 10 agents across Start / Market / Harbor")

System.Print("Initial topology")
logLoads(agents, "initial")

System.Print("Pi policy: reroute the Market crowd to Harbor")
for (i = 4; i < 8; i = i + 1) {
    agents[i].plans = agents[i].plans + 1
    moveAgent(agents[i], "Harbor", "Pi reroute")
}
timeline.append("tick 20: Pi reroutes Market traffic to Harbor")
snapshot20 = snapshotAgents(agents, 20)

System.Print("Balancer shifts pressure from NodeA to NodeD")
moveAgent(agents[0], "Backup", "load balancing")
moveAgent(agents[1], "Backup", "load balancing")
timeline.append("tick 25: load balancing shifts two agents to Backup")

System.Print("Failure drill: force agents 1, 2, and 3 onto Market")
moveAgentById(agents, 1, "Market", "failure drill")
moveAgentById(agents, 2, "Market", "failure drill")
moveAgentById(agents, 3, "Market", "failure drill")
timeline.append("tick 56: drill moves agents 1-3 into Market")

snapshot60 = snapshotAgents(agents, 60)
timeline.append("tick 60: capture snapshot before failure")

System.Print("NodeB fails; agents 1-3 are restored on NodeD")
agents = restoreFromSnapshots(snapshot60, "NodeB", "Backup")
timeline.append("tick 60: failure and restore complete")

System.Print("Final agent state")
for (i = 0; i < agents.Count; i = i + 1) {
    System.Print("  - " + describeAgent(agents[i]))
}

System.Print("Timeline")
for (i = 0; i < timeline.Count; i = i + 1) {
    System.Print("  * " + timeline[i])
}

System.Print("Restored agents: " + countRestored(agents))
countRestored(agents)
