// Tests for while loop functionality in Rho
// Tests basic while loops, break conditions, and nesting

// Basic while loop
i = 0
sum = 0
while i < 10
    sum = sum + i
    i = i + 1
assert(sum == 45)
assert(i == 10)

// While loop with break
i = 0
sum = 0
while true
    if i >= 5
        break
    sum = sum + i
    i = i + 1
assert(sum == 10)  // 0+1+2+3+4
assert(i == 5)

// While loop with early termination via condition
i = 0
product = 1
while i < 10 && product < 100
    i = i + 1
    product = product * 2
assert(product == 128)
assert(i == 7)  // 2^7 = 128, which exceeds 100, so we stop at i=7

// Nested while loops
outer = 0
inner_sum = 0
total = 0
while outer < 3
    inner = 0
    while inner < outer
        inner_sum = inner_sum + 1
        inner = inner + 1
    total = total + outer
    outer = outer + 1
assert(inner_sum == 3)  // 0 + 1 + 2 = 3
assert(total == 3)      // 0 + 1 + 2 = 3

// While loop with state manipulation
array = [1, 2, 3, 4, 5]
index = 0
sum = 0
while index < 5  // array.length would be 5
    sum = sum + array[index]
    index = index + 1
assert(sum == 15)

// More complex termination condition
a = 10
b = 20
while a < b && b > 15
    a = a + 2
    b = b - 1
assert(a == 16)
assert(b == 17)