// Direct test of all iteration constructs we've implemented

// TEST 1: Basic while loop
i = 0
sum = 0
while i < 5
    sum = sum + i
    i = i + 1
assert(sum == 10)  // 0+1+2+3+4 = 10
assert(i == 5)

// TEST 2: Basic for loop
sum = 0
for i = 0; i < 5; i = i + 1
    sum = sum + i
assert(sum == 10)  // 0+1+2+3+4 = 10

// TEST 3: Basic do-while loop
i = 0
sum = 0
do
    sum = sum + i
    i = i + 1
while i < 5
assert(sum == 10)  // 0+1+2+3+4 = 10
assert(i == 5)

// TEST 4: do-while that executes once even with false condition
i = 10
executed = false
do
    executed = true
    i = i + 1
while i < 10  // This is already false
assert(executed == true)
assert(i == 11)  // Should increment once

// TEST 5: foreach over array
array = [1, 2, 3, 4, 5]
sum = 0
for element in array
    sum = sum + element
assert(sum == 15)  // 1+2+3+4+5 = 15

// TEST 6: while loop with break
i = 0
sum = 0
while i < 10
    if i >= 5
        break
    sum = sum + i
    i = i + 1
assert(sum == 10)  // 0+1+2+3+4 = 10
assert(i == 5)

// TEST 7: for loop with break
sum = 0
for i = 0; i < 10; i = i + 1
    if i >= 5
        break
    sum = sum + i
assert(sum == 10)  // 0+1+2+3+4 = 10

// TEST 8: Nested loops
outer_sum = 0
for i = 0; i < 3; i = i + 1
    inner_sum = 0
    for j = 0; j < i; j = j + 1
        inner_sum = inner_sum + 1
    outer_sum = outer_sum + inner_sum
assert(outer_sum == 3)  // 0 + 1 + 2 = 3

// TEST 9: Object property iteration
person = object()
person.name = "John"
person.age = 30
person.city = "New York"

properties = []
for key in person
    properties.push(key)
assert(properties.length == 3)