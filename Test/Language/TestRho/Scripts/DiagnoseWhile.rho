// DiagnoseWhile.rho
// An extremely minimal while loop for diagnostic purposes
// This is for isolating while loop issues

// Turn on tracing if supported
print("=== START WHILE LOOP DIAGNOSTIC ===")

// Simple initialization
print("Initializing i = 0")
i = 0
print("i = " + i)

// Most basic while loop possible
print("Entering while loop: while i < 3")
while i < 3
    print("Loop body: i = " + i)
    i = i + 1
    print("Incremented: i = " + i)

// Print result
print("After loop: i = " + i)
print("=== END WHILE LOOP DIAGNOSTIC ===")