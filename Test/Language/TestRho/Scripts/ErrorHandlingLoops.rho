// Error Handling with Loops
// Tests error handling during iterations

// TEST 1: Try-catch with loops
errorCounter = 0
successCounter = 0

// Define a loop that sometimes generates errors
riskyLoop = continuation
    for i = 0; i < 10; i = i + 1
        try
            // Generate error for even numbers
            if i % 2 == 0
                throw "EvenNumberError"
            end
            
            // If we get here, no error occurred
            successCounter = successCounter + 1
        catch e
            // Handle the error
            errorCounter = errorCounter + 1
        end
    end
end

// Run the loop with error handling
riskyLoop()

// Check counters
assert(errorCounter == 5)  // i = 0,2,4,6,8
assert(successCounter == 5) // i = 1,3,5,7,9

// TEST 2: Error propagation between nested loops
outerErrors = 0
innerErrors = 0

// Define nested loops with errors
nestedErrorLoops = continuation
    try
        for i = 0; i < 5; i = i + 1
            try
                for j = 0; j < 3; j = j + 1
                    // Throw from inner loop when j = 1
                    if j == 1
                        throw "InnerError"
                    end
                end
            catch e
                // Count inner errors
                innerErrors = innerErrors + 1
            end
            
            // Throw from outer loop when i = 3
            if i == 3
                throw "OuterError"
            end
        end
    catch e
        // Count outer errors
        outerErrors = outerErrors + 1
    end
end

// Run the nested error handling loops
nestedErrorLoops()

// Verify error counts
assert(innerErrors == 5) // One for each outer iteration (i = 0,1,2,3,4)
assert(outerErrors == 1) // One from i = 3

// TEST 3: Recovery and continuation after errors
recoveryCounter = 0
errorOccurred = false

// Define a continuation to handle errors
errorHandler = continuation
    errorOccurred = true
    recoveryCounter = recoveryCounter + 1
end

// Define a loop that recovers from errors
recoveryLoop = continuation
    for i = 0; i < 5; i = i + 1
        try
            // Generate error in the middle of the loop
            if i == 2
                throw "MidLoopError"
            end
        catch e
            // Handle the error and recover
            errorHandler()
        end
    end
end

// Run the recovery loop
recoveryLoop()

// Verify recovery
assert(errorOccurred == true)
assert(recoveryCounter == 1) // Only one error at i = 2

// TEST 4: Complex error flow control
stages = []
errors = []

// Define a multi-stage process with potential errors
processingStages = continuation
    // Process multiple items
    for i = 0; i < 3; i = i + 1
        stages.push("Start processing item " + i)
        
        try
            // Processing stages
            for stage = 1; stage <= 3; stage = stage + 1
                stages.push("Item " + i + " stage " + stage)
                
                // Introduce errors
                if i == 1 && stage == 2
                    throw "ProcessingError"
                end
            end
            
            stages.push("Completed item " + i)
        catch e
            errors.push("Error in item " + i)
            
            // Skip to next item
            continue
        end
    end
    
    stages.push("All processing complete")
end

// Run the processing stages
processingStages()

// Verify stages and errors
assert(stages.length == 13) // Correct number of processing stages
assert(errors.length == 1)  // One error during processing
assert(errors[0] == "Error in item 1")

// TEST 5: Nested loops with try-catch and continuations
outerLoop = continuation
    try
        for i = 0; i < 3; i = i + 1
            try
                for j = 0; j < i; j = j + 1
                    // Nested processing
                    if i == 2 && j == 1
                        throw "NestedLoopError"
                    end
                end
            catch e
                // Handle nested error but continue outer loop
                continue
            end
        end
    catch e
        // This should not be reached
        assert(false)
    end
end

// Run the nested loops with error handling
outerLoop()

// TEST 6: Cleanup actions in loops
initializations = 0
cleanups = 0

// Define resource management patterns
resourceLoop = continuation
    for i = 0; i < 5; i = i + 1
        // Initialize resource
        initializations = initializations + 1
        
        try
            // Use resource - may throw
            if i == 3
                throw "ResourceError"
            end
        finally
            // Always clean up
            cleanups = cleanups + 1
        end
    end
end

// Run the resource management loop
resourceLoop()

// Verify all resources were properly cleaned up
assert(initializations == 5) // All iterations started
assert(cleanups == 5)        // All resources cleaned up