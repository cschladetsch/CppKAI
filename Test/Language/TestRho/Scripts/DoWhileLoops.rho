// Tests for do-while loop functionality in Rho
// Tests basic do-while loops, break conditions, and guarantees

// Basic do-while loop
i = 0
sum = 0
do
    sum = sum + i
    i = i + 1
while i < 10
assert(sum == 45)
assert(i == 10)

// Do-while loop that executes at least once
i = 10
executed = false
do
    executed = true
    i = i + 1
while i < 10  // Condition is false, but body still executes once
assert(executed == true)
assert(i == 11)

// Do-while loop with break
i = 0
sum = 0
do
    if i >= 5
        break
    sum = sum + i
    i = i + 1
while true
assert(sum == 10)  // 0+1+2+3+4
assert(i == 5)

// Do-while loop with continue
i = 0
sum = 0
do
    i = i + 1
    if i % 2 == 0  // Skip even numbers
        continue
    sum = sum + i
while i < 10
assert(sum == 25)  // 1+3+5+7+9

// Nested do-while loops
outer = 0
inner_sum = 0
do
    inner = 0
    do
        inner_sum = inner_sum + 1
        inner = inner + 1
    while inner < outer
    outer = outer + 1
while outer < 3
assert(inner_sum == 3)  // 0 + 1 + 2 = 3

// Do-while with complex condition
a = 5
b = 10
do
    a = a + 1
    b = b - 1
while a < 10 && b > 5
assert(a == 10)
assert(b == 5)

// Do-while for finding a value
target = 42
guess = 0
attempts = 0
do
    guess = (guess + 10) % 100
    attempts = attempts + 1
while guess != target && attempts < 10
assert(attempts <= 10)
assert(guess == 42 || attempts == 10)  // Either found the target or maxed out attempts