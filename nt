#!/bin/bash

# Script to build and run a specific test using Ninja
# Usage: ./nt [TestName]
# Example: ./nt TestPi, ./nt TestRho

# Define the Ninja-specific build directory
BUILD_DIR="build_ninja"

# Check if test name is provided
if [ $# -lt 1 ]; then
    echo "Usage: $0 [TestName]"
    echo "Example: $0 TestPi"
    echo "Available tests:"
    if [ -d "$BUILD_DIR/Bin" ]; then
        ls "$BUILD_DIR/Bin/Test*" 2>/dev/null | xargs -n1 basename 2>/dev/null || echo "  No tests found in build directory"
    else
        echo "  Build directory not found. Run ./n first."
    fi
    exit 1
fi

TEST_NAME=$1

# Check if build directory exists, if not create it
if [ ! -d "$BUILD_DIR" ]; then
    echo "Creating Ninja build directory ($BUILD_DIR)..."
    mkdir -p "$BUILD_DIR"
    cd "$BUILD_DIR"
    cmake -G Ninja ..
    if [ $? -ne 0 ]; then
        echo "CMake configuration failed!"
        exit 1
    fi
    cd ..
fi

# Build with Ninja
cd "$BUILD_DIR"
echo "Building $TEST_NAME with Ninja..."
ninja $TEST_NAME
BUILD_RESULT=$?

if [ $BUILD_RESULT -ne 0 ]; then
    echo "Build failed with error code $BUILD_RESULT"
    cd ..
    exit $BUILD_RESULT
fi

cd ..

# Define colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
PURPLE='\033[0;35m'
RESET='\033[0m'

# Run the test
echo -e "${PURPLE}---- Running $TEST_NAME ----${RESET}"
TEST_PATH="$BUILD_DIR/Bin/$TEST_NAME"

if [ -x "$TEST_PATH" ]; then
    $TEST_PATH
    TEST_RESULT=$?
    
    if [ $TEST_RESULT -eq 0 ]; then
        echo -e "${GREEN}$TEST_NAME passed successfully!${RESET}"
    else
        echo -e "${RED}$TEST_NAME failed with exit code $TEST_RESULT${RESET}"
    fi
    
    exit $TEST_RESULT
else
    echo -e "${RED}Error: $TEST_NAME executable not found at $TEST_PATH${RESET}"
    exit 1
fi