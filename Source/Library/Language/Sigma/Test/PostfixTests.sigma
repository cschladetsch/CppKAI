# Sigma Postfix Operator Test Suite (All 20 Cases)

## 1. Force / Eager Execution (!)

# Test 1: Immediate Deferred Block Evaluation
block = { print("Executing!"); 42 }
result = block!
assert(result == 42)

# Test 2: Stripping Optional/Nullability
get_user = fun(id) -> id > 0 ? "Alice" : null
name = get_user(1)!
assert(name == "Alice")

# Test 3: Forced Continuation Trigger
task = async_fetch_data("https://api.local")
payload = task!
assert(payload.status == 200)

# Test 4: Chained Forced Call
get_handler = fun() -> { print("Handled") }
get_handler()!


## 2. Spread / Variadic Expansion (...)

# Test 5: Spreading Array Arguments into Function Call
add = fun(a, b, c) -> a + b + c
args = [10, 20, 30]
sum = add(args...)
assert(sum == 60)

# Test 6: Concatenating Lists via Call Expansion
concat = fun(...lists) -> lists
first = [1, 2]
second = [3, 4]
combined = concat(first..., second...)
assert(combined == [1, 2, 3, 4])

# Test 7: Spreading Tuple Return Values
get_coords = fun() -> (12.5, 45.1)
plot_point = fun(x, y) -> x + y
total = plot_point(get_coords()...)
assert(total == 57.6)

# Test 8: Spreading Dictionary Keywords
configure = fun(host, port) -> host + ":" + string(port)
opts = { host: "localhost", port: 8080 }
url = configure(opts...)
assert(url == "localhost:8080")


## 3. Reference / Continuation Capture (&)

# Test 9: Lazy Evaluation Capture
expensive_calc = fun(x) -> x * 100
lazy_ref = expensive_calc(5)&
assert(lazy_ref() == 500)

# Test 10: Pass-by-Reference Argument Handling
increment = fun(val_ref) -> val_ref = val_ref + 1
count = 10
increment(count&)
assert(count == 11)

# Test 11: Continuations as Arguments
register_callback = fun(cb) -> cb()
flag = false
set_flag = fun() -> flag = true
register_callback(set_flag()&)
assert(flag == true)

# Test 12: Struct/Object Reference Binding
obj = { value: 100, get_val: fun() -> value }
ref_call = obj.get_val()&
assert(ref_call() == 100)


## 4. Combined Postfix Operators

# Test 13: Spread then Force (... followed by !)
run_all = fun(a, b) -> { a + b }
args = [5, 15]
res = run_all(args...)!
assert(res == 20)

# Test 14: Force and Capture Reference (! followed by &)
make_thunk = fun() -> { 99 }
ref = make_thunk()!&
assert(ref() == 99)

# Test 15: Spread Reference Arguments (& inside ...)
x = 1; y = 2
refs = [x&, y&]
sum_refs = fun(r1, r2) -> r1 + r2
assert(sum_refs(refs...) == 3)

# Test 16: Spread into Forced Execution (... inside !)
make_block = fun(a, b) -> { a * b }
params = [3, 4]
result = make_block(params...)!
assert(result == 12)


## 5. Advanced Pipeline & Nested Call Mechanics

# Test 17: Chained Forced Calls in Method Pipelines
builder = fun() -> { fun() -> "finished" }
res = builder()!()!
assert(res == "finished")

# Test 18: Variadic Continuation Aggregation (... and &)
f1 = fun() -> 1
f2 = fun() -> 2
calls = [f1()&, f2()&]
exec_all = fun(c1, c2) -> c1() + c2()
assert(exec_all(calls...) == 3)

# Test 19: Nested Postfix Scope Assertions
process = fun(a, b) -> a + b
deferred_a = { 10 }
deferred_b = { 20 }
args = [deferred_a!, deferred_b!]
assert(process(args...) == 30)

# Test 20: Full Composite Mechanics (..., &, !)
compute = fun(x, y) -> { x^y }
inputs = [2, 3]
lazy_action = compute(inputs...)&
forced_result = lazy_action!
assert(forced_result == 8)
